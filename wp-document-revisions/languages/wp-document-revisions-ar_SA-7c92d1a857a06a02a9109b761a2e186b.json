            "Open documents in new tab?": [
                "\u0647\u0644 \u062a\u0631\u064a\u062f \u0641\u062a\u062d \u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0641\u064a \u0639\u0644\u0627\u0645\u0629 \u062a\u0628\u0648\u064a\u0628 \u062c\u062f\u064a\u062f\u0629\u061f"
