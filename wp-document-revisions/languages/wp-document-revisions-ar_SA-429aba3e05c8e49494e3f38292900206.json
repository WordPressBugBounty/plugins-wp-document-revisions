            ],
            "Show Edit link allows the list to have a link to the Edit function. A choice made here will over-ride the system-configured settings. Links will only appear if the user can edit the document.": [
                "\u064a\u064f\u062a\u064a\u062d \u062e\u064a\u0627\u0631 \"\u0625\u0638\u0647\u0627\u0631 \u0631\u0627\u0628\u0637 \u0627\u0644\u062a\u062d\u0631\u064a\u0631\" \u0625\u0636\u0627\u0641\u0629 \u0631\u0627\u0628\u0637 \u0625\u0644\u0649 \u0648\u0638\u064a\u0641\u0629 \u0627\u0644\u062a\u062d\u0631\u064a\u0631 \u0641\u064a \u0627\u0644\u0642\u0627\u0626\u0645\u0629. \u0633\u064a\u0624\u062f\u064a \u0627\u062e\u062a\u064a\u0627\u0631 \u0647\u0630\u0627 \u0627\u0644\u062e\u064a\u0627\u0631 \u0625\u0644\u0649 \u062a\u062c\u0627\u0648\u0632 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u064f\u0633\u0628\u0642\u0629 \u0644\u0644\u0646\u0638\u0627\u0645. \u0648\u0644\u0646 \u062a\u0638\u0647\u0631 \u0627\u0644\u0631\u0648\u0627\u0628\u0637 \u0625\u0644\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0628\u0625\u0645\u0643\u0627\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0645\u0633\u062a\u0646\u062f."
            ],
            "Default": [
                "\u062a\u0642\u0635\u064a\u0631"
            ],
            "No Edit link": [
                "\u0631\u0627\u0628\u0637 \u0644\u0627 \u064a\u0633\u0645\u062d \u0628\u0627\u0644\u062a\u0639\u062f\u064a\u0644"
