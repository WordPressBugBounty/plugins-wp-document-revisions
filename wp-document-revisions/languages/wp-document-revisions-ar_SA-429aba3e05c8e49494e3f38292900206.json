            ],
            "Setting this on will open the document in a new tab. This should be set on whilst editing the page using this block as clicking on a link whilst editing will force the current page to be left.": [
                "\u0633\u064a\u0624\u062f\u064a \u062a\u0641\u0639\u064a\u0644 \u0647\u0630\u0627 \u0627\u0644\u062e\u064a\u0627\u0631 \u0625\u0644\u0649 \u0641\u062a\u062d \u0627\u0644\u0645\u0633\u062a\u0646\u062f \u0641\u064a \u0639\u0644\u0627\u0645\u0629 \u062a\u0628\u0648\u064a\u0628 \u062c\u062f\u064a\u062f\u0629. \u064a\u064f\u0646\u0635\u062d \u0628\u062a\u0641\u0639\u064a\u0644\u0647 \u0623\u062b\u0646\u0627\u0621 \u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0635\u0641\u062d\u0629 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0647\u0630\u0627 \u0627\u0644\u0642\u0633\u0645\u060c \u062d\u064a\u062b \u0623\u0646 \u0627\u0644\u0646\u0642\u0631 \u0639\u0644\u0649 \u0631\u0627\u0628\u0637 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062a\u062d\u0631\u064a\u0631 \u0633\u064a\u0624\u062f\u064a \u0625\u0644\u0649 \u0645\u063a\u0627\u062f\u0631\u0629 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629."
            ],
            "Free Form Settings": [
                "\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u062d\u0631"
            ],
