            ],
            "Show Edit link allows the list to have a link to the Edit function. A choice made here will over-ride the system-configured settings. Links will only appear if the user can edit the document.": [
                "\"\u05d4\u05e6\u05d2 \u05e7\u05d9\u05e9\u05d5\u05e8 \u05e2\u05e8\u05d9\u05db\u05d4\" \u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05e8\u05e9\u05d9\u05de\u05d4 \u05dc\u05db\u05dc\u05d5\u05dc \u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e4\u05d5\u05e0\u05e7\u05e6\u05d9\u05d9\u05ea \u05d4\u05e2\u05e8\u05d9\u05db\u05d4. \u05d1\u05d7\u05d9\u05e8\u05d4 \u05e9\u05ea\u05d1\u05d5\u05e6\u05e2 \u05db\u05d0\u05df \u05ea\u05e2\u05e7\u05d5\u05e3 \u05d0\u05ea \u05d4\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05e9\u05ea\u05e6\u05d5\u05e8\u05ea\u05df \u05e0\u05e7\u05d1\u05e2\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05de\u05e2\u05e8\u05db\u05ea. \u05e7\u05d9\u05e9\u05d5\u05e8\u05d9\u05dd \u05d9\u05d5\u05e4\u05d9\u05e2\u05d5 \u05e8\u05e7 \u05d0\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d9\u05db\u05d5\u05dc \u05dc\u05e2\u05e8\u05d5\u05da \u05d0\u05ea \u05d4\u05de\u05e1\u05de\u05da."
            ],
            "Default": [
                "\u05d1\u05bc\u05b0\u05e8\u05b4\u05d9\u05e8\u05b7\u05ea \u05de\u05b6\u05d7\u05d3\u05b8\u05dc"
            ],
            "No Edit link": [
