            ],
            "Setting this on will open the document in a new tab. This should be set on whilst editing the page using this block as clicking on a link whilst editing will force the current page to be left.": [
                "\u05d4\u05e4\u05e2\u05dc\u05d4 \u05e9\u05dc \u05d0\u05e4\u05e9\u05e8\u05d5\u05ea \u05d6\u05d5 \u05ea\u05e4\u05ea\u05d7 \u05d0\u05ea \u05d4\u05de\u05e1\u05de\u05da \u05d1\u05db\u05e8\u05d8\u05d9\u05e1\u05d9\u05d9\u05d4 \u05d7\u05d3\u05e9\u05d4. \u05d9\u05e9 \u05dc\u05d4\u05e4\u05e2\u05d9\u05dc \u05d0\u05d5\u05ea\u05d4 \u05d1\u05e2\u05ea \u05e2\u05e8\u05d9\u05db\u05ea \u05d4\u05d3\u05e3 \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05d1\u05dc\u05d5\u05e7 \u05d6\u05d4, \u05e9\u05db\u05df \u05dc\u05d7\u05d9\u05e6\u05d4 \u05e2\u05dc \u05e7\u05d9\u05e9\u05d5\u05e8 \u05d1\u05d6\u05de\u05df \u05e2\u05e8\u05d9\u05db\u05d4 \u05ea\u05db\u05e8\u05d9\u05d7 \u05d0\u05ea\u05db\u05dd \u05dc\u05e2\u05d6\u05d5\u05d1 \u05d0\u05ea \u05d4\u05d3\u05e3 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9."
            ],
            "Free Form Settings": [
                "\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05e6\u05d5\u05e8\u05d4 \u05d7\u05d5\u05e4\u05e9\u05d9\u05ea"
            ],
            "Free-form parameters": [
                "\u05e4\u05e8\u05de\u05d8\u05e8\u05d9\u05dd \u05d7\u05d5\u05e4\u05e9\u05d9\u05d9\u05dd"
